# Copy to ~/.ebay-mcp/sandbox.env (outside the repo). On Linux/macOS also: chmod 600 ~/.ebay-mcp/sandbox.env
# Point the server at it with EBAY_MCP_ENV_FILE. Real environment variables override this file.

EBAY_ENV=sandbox                       # sandbox | production
EBAY_CLIENT_ID=                        # App ID (Client ID) from your keyset
EBAY_CLIENT_SECRET=                    # Cert ID (Client Secret)
EBAY_RU_NAME=                          # RuName from "User Tokens" (only used by get_refresh_token.py)
# EBAY_REFRESH_TOKEN is written here by scripts/get_refresh_token.py

EBAY_MCP_WRITES_ENABLED=false          # kill switch: confirm_change refuses until this is true
EBAY_MCP_DB=~/.ebay-mcp/sandbox.db     # audit log + pending previews (one file per environment)

# Cost source: json (sandbox) or sheets (production)
EBAY_MCP_COST_SOURCE=json
EBAY_MCP_COST_JSON=~/.ebay-mcp/costs.json
# EBAY_MCP_SHEET_ID=                   # the long ID in the sheet URL
# EBAY_MCP_SHEET_TAB=Lucas Resell
# GOOGLE_SERVICE_ACCOUNT_FILE=~/.ebay-mcp/sheets-reader.json
# Column letters (defaults shown)
# EBAY_MCP_SHEET_DATE_COL=A            # purchase date
# EBAY_MCP_SHEET_TITLE_COL=B           # item
# EBAY_MCP_SHEET_COST_COL=I            # total cost
# EBAY_MCP_SHEET_STATUS_COL=J
# EBAY_MCP_SHEET_ITEMID_COL=V          # eBay item ID
# EBAY_MCP_SHEET_AGED_COL=W            # Y = aged, a loss is allowed after 12 months
# EBAY_MCP_SHEET_FLOOR_COL=X           # optional per-item floor (can only raise the floor)

# Daily caps per API (defaults shown)
# EBAY_MCP_DAILY_LIMIT_TRADING=4000
# EBAY_MCP_DAILY_LIMIT_FULFILLMENT=2000
# EBAY_MCP_DAILY_LIMIT_FINANCES=2000
# EBAY_MCP_DAILY_LIMIT_NEGOTIATION=500
# EBAY_MCP_DAILY_LIMIT_BROWSE=2000

# Remote hosting only (see README, "Remote hosting"). All four OAuth values are required.
# EBAY_MCP_TRANSPORT=streamable-http
# EBAY_MCP_PUBLIC_URL=https://ebay-mcp.example.com/mcp
# EBAY_MCP_OAUTH_ISSUER=https://your-tenant.us.auth0.com/
# EBAY_MCP_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
# EBAY_MCP_ALLOWED_SUBJECTS=auth0|your-user-id
